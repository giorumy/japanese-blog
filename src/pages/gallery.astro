---
import BlogLayout from "../layouts/blog-layout.astro";

const images = [
  "me-picture.jpg",
  "western-asian.png",
  "dragon.jpg",
  "cloud-dragon.png",
  "koinobori-baby.webp",
  "koinobori-old.jpg",
  "shinkansen.jpg",
  "kuromatsu.JPG"
];
---

<BlogLayout>
  <h1>ギャラリー</h1>

  <div class="gallery">
    {images.map((image) => (
      <img
        src={`/japanese-blog/images/${image}`}
        alt={image.split(".")[0]}
        loading="lazy"
      />
    ))}
  </div>
</BlogLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 16px;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: cover;
    border: 4px groove #ccc;
  }
</style>